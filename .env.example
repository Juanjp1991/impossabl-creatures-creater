# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional (local dev): route AI calls through an OpenAI-compatible proxy such as
# CLIProxyAPI (https://github.com/router-for-me/CLIProxyAPI) to use a ChatGPT/Codex
# or Claude subscription instead of a Google key. When AI_PROXY_URL is set the app
# uses the OpenAI Chat Completions protocol (which preserves JSON-schema output),
# AI_PROXY_KEY is the proxy's client key, and GEMINI_MODEL is the routed model id.
# AI_PROXY_URL="http://localhost:8317/v1"
# AI_PROXY_KEY="local-dev-key"
# GEMINI_MODEL="gpt-5.6-sol"
# AI_PROXY_TIMEOUT_MS="600000" # 10 minutes; raise for exceptionally large SVG generations

# In-app model selector (§7): the UI at GET /api/models lists every model below and the
# chosen one drives all AI calls. Both providers can be live at once. Comma-separated:
#   AI_PROXY_MODELS — models the proxy serves (defaults to GEMINI_MODEL when unset).
#   GEMINI_MODELS   — direct Google Gemini models (needs a valid GEMINI_API_KEY).
# Example (proxy + direct Gemini side by side):
# AI_PROXY_MODELS="gpt-5.6-sol,claude-sonnet-4"
# GEMINI_MODELS="gemini-3.6-flash,gemini-2.5-pro"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
