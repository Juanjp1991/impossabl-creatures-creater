# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_IMAGE_MODEL: image model for the "generate reference from brief" sketch button
# (POST /api/generate-image). Always uses GEMINI_API_KEY — the subscription providers
# (proxy, Cline) serve no image generation. Defaults to gemini-3.1-flash-image when unset;
# gemini-3-pro-image is the slower quality option, gemini-2.5-flash-image the fallback.
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# Optional (local dev): route AI calls through an OpenAI-compatible proxy such as
# CLIProxyAPI (https://github.com/router-for-me/CLIProxyAPI) to use a ChatGPT/Codex
# or Claude subscription instead of a Google key. When AI_PROXY_URL is set the app
# uses the OpenAI Chat Completions protocol (which preserves JSON-schema output),
# AI_PROXY_KEY is the proxy's client key, and GEMINI_MODEL is the routed model id.
# AI_PROXY_URL="http://localhost:8317/v1"
# AI_PROXY_KEY="local-dev-key"
# GEMINI_MODEL="gpt-5.6-sol"

# In-app model selector (§7): the UI at GET /api/models lists every model below and the
# chosen one drives all AI calls. All providers can be live at once. Comma-separated:
#   AI_PROXY_MODELS — models the proxy serves (defaults to GEMINI_MODEL when unset).
#   GEMINI_MODELS   — direct Google Gemini models (needs a valid GEMINI_API_KEY).
#   CLINE_MODELS    — Cline Pass models via Cline's gateway (see below).
# Example (proxy + direct Gemini side by side):
# AI_PROXY_MODELS="gpt-5.6-sol,claude-sonnet-4"
# GEMINI_MODELS="gemini-3.6-flash,gemini-2.5-pro"

# Cline Pass subscription (https://docs.cline.bot/getting-started/clinepass) via Cline's
# OpenAI-compatible gateway — no local proxy needed. Auth: CLINE_API_KEY from
# app.cline.bot → Settings → API Keys, or leave unset to reuse the Cline CLI's OAuth
# session (~/.cline/data/settings/providers.json), re-read per request. Quirks: the
# gateway accepts response_format:json_schema but rejects json_object (the server never
# sends it); cline-pass/kimi-k3 has vision. CLINE_REASONING="off" omits reasoning_effort.
# CLINE_MODELS="cline-pass/kimi-k3"
# CLINE_API_KEY=""
# CLINE_API_URL="https://api.cline.bot/api/v1"
# CLINE_REASONING="low"
# CLINE_TIMEOUT_MS="600000"
# CLINE_TEXT_ONLY_MODELS=""
# CLINE_PROMPT_SCHEMA_MODELS=""

# Optional sampling temperature (0-2) per provider. Unset = nothing is sent and each
# upstream uses its own default. GPT-5.x/o-family reasoning models 400 on temperature ≠ 1,
# so leave AI_PROXY_TEMPERATURE unset when those are in AI_PROXY_MODELS.
# AI_PROXY_TEMPERATURE=""
# CLINE_TEMPERATURE=""
# GEMINI_TEMPERATURE=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
